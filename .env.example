# Environment configuration template (specification §24).
#
# Copy to backend/.env for local development. Never commit a real .env (CLAUDE.md).
# Production values come from Secret Manager, not from files.
#
# Defaults here select FAKE providers, so the stack runs locally with no credentials.

# ---------------------------------------------------------------- core
APP_ENV=local
APP_SECRET=dev-insecure-change-me
LOG_LEVEL=INFO
LOG_FORMAT=console

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_marketing

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ---------------------------------------------------------------- session [D2]
SESSION_COOKIE_NAME=wam_session
# Keep true in production. May be false only for local http development.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------------- provider selection
# fake | meta
WHATSAPP_PROVIDER=fake
# fake | openrouter
LLM_PROVIDER=fake
# fake | local_sentence_transformer
EMBEDDING_PROVIDER=fake
# fake | google
CALENDAR_PROVIDER=fake
# fake | hubspot
CRM_PROVIDER=fake
# inline | cloud_tasks
QUEUE_PROVIDER=inline

# ---------------------------------------------------------------- WhatsApp
# fake | meta. Everything below is required only when WHATSAPP_PROVIDER=meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Chosen by you and echoed back to Meta during the webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=
# Meta's App Secret. Used to verify the HMAC-SHA256 signature on every webhook
# delivery (§19). Not listed in §24; without it anyone who knows the URL could
# fabricate customer replies and opt-outs.
WHATSAPP_APP_SECRET=
# WhatsApp Business Account ID. Message templates hang off the WABA, not the phone
# number, so the template sync needs it ([D6]).
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_TIMEOUT_SECONDS=15

# Meta permits free-form (non-template) replies only within this many hours of the
# customer's last inbound message. Configurable because Meta has changed it before.
CUSTOMER_SERVICE_WINDOW_HOURS=24

# ---------------------------------------------------------------- LLM (Phase 10)
OPENROUTER_API_KEY=
# [D17] No default. Chosen after Phase 10 benchmarking; required when
# LLM_PROVIDER=openrouter.
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Generous next to the WhatsApp timeout: a model generating a long reply legitimately
# takes tens of seconds, and cutting it off wastes the tokens already spent.
OPENROUTER_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- AI agent (§9, §11)
# How many rounds of tool calls one turn may take. Enough for look up the lead -> record
# facts -> fetch slots -> book, and short enough that a confused model cannot loop at
# the customer's expense. The final round is asked without tools, which is what makes
# the loop terminate.
AI_MAX_TOOL_ROUNDS=4
# Whether the agent retrieves knowledge before replying. Off leaves it answering from
# the conversation alone, which is the safe setting before the client's documents are
# loaded (Section 11).
AI_RETRIEVAL_ENABLED=true
# Which knowledge base the AI answers from. Optional when there is exactly one; with
# several, an unset value means the AI declines to answer from any of them rather than
# guessing.
AI_KNOWLEDGE_BASE_NAME=

# ---------------------------------------------------------------- embeddings [D1]
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the pgvector column width. 384 for all-MiniLM-L6-v2. Changing this is a
# migration plus full re-embedding.
EMBEDDING_DIMENSION=384
# How many chunks are encoded per forward pass. Higher is faster but uses more
# memory; the worker's Cloud Run memory limit is the constraint.
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------- RAG (Phase 8, §11)
# all-MiniLM-L6-v2 accepts 256 word-pieces and SILENTLY truncates the rest, so an
# over-long chunk is embedded from its opening words alone with no error. At roughly
# four characters per token, 800 characters stays comfortably inside that window.
# Raising this past ~1000 degrades retrieval invisibly.
RAG_CHUNK_CHARS=800
# Overlap so a fact split across a boundary stays retrievable from one side.
RAG_CHUNK_OVERLAP_CHARS=120
# How many chunks retrieval returns.
RAG_TOP_K=5
# Below this cosine similarity a chunk is treated as no evidence at all. A weak match
# is worse than none: it turns "I don't know" into a confident wrong answer.
RAG_MIN_SIMILARITY=0.25
# Ceiling on the assembled context. An unbounded context buries the relevant passage
# and costs more per call.
RAG_MAX_CONTEXT_CHARS=4000
# Upload limit (§19). V1 sends document bytes inside the Cloud Tasks payload, which
# caps a task at 1 MB; base64 costs a third. Raising this with QUEUE_PROVIDER=
# cloud_tasks is refused at startup — it needs object storage first.
KNOWLEDGE_MAX_FILE_BYTES=700000

# ---------------------------------------------------------------- Google Cloud (Phase 7)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_TASKS_QUEUE=
WORKER_BASE_URL=
WORKER_SERVICE_ACCOUNT_EMAIL=

# ---------------------------------------------------------------- Calendar (Phase 11)
# [D7] One shared sales calendar, Google OAuth.
GOOGLE_CALENDAR_ID=
# [D19] The OAuth refresh token lives in Secret Manager, never here and never in the
# database. These name its location.
GOOGLE_SECRET_MANAGER_PROJECT=
GOOGLE_CALENDAR_TOKEN_SECRET_NAME=

# ---------------------------------------------------------------- CRM (Phase 12)
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------- audience [D4][D20]
AUDIENCE_PHONE_DEFAULT_REGION=IN

# Maps the client's spreadsheet headers onto platform fields. A phone column is
# mandatory and must be required, since the normalized number is the WhatsApp
# identity ([D11]).
#
# The value below is a DEVELOPMENT PLACEHOLDER, not the client's format. Production
# refuses to start until it is replaced, so building the pipeline ahead of the
# client's file cannot leak invented column names into production ([D20]).
# Swapping in the real names needs no code change.
# Canonical fields [D25]: name, phone (both required), email, company, designation,
# city. Only the "source" header names change per client; the fields never do.
#
# The value below is a DEVELOPMENT PLACEHOLDER using the canonical names as headers.
# Production refuses to start with it [D32], so a real mapping is always supplied.
# A client mapping looks like:
#   [{"source": "Full Name", "field": "name", "required": true},
#    {"source": "Mobile Number", "field": "phone", "required": true},
#    {"source": "Email ID", "field": "email", "required": false},
#    {"source": "Organization", "field": "company", "required": false},
#    {"source": "Job Title", "field": "designation", "required": false},
#    {"source": "Location", "field": "city", "required": false}]
AUDIENCE_COLUMN_SCHEMA=[{"source": "Name", "field": "name", "required": true}, {"source": "Phone", "field": "phone", "required": true}, {"source": "Email", "field": "email", "required": false}, {"source": "Company", "field": "company", "required": false}, {"source": "Designation", "field": "designation", "required": false}, {"source": "City", "field": "city", "required": false}]

# Upload limits (§19).
AUDIENCE_MAX_FILE_BYTES=5242880
AUDIENCE_MAX_ROWS=50000

# ---------------------------------------------------------------- retries [D27]
# Attempts per recipient, counting the first.
SEND_MAX_ATTEMPTS=5
SEND_BACKOFF_BASE_SECONDS=2.0
SEND_BACKOFF_MAX_SECONDS=300.0
# Fraction of the delay applied as random jitter. Without it a batch that fails
# together retries together, recreating the spike that caused the failure.
SEND_BACKOFF_JITTER=0.25

# ---------------------------------------------------------------- dispatch [D28]
# Deliberately empty. [D28] forbids assuming a Meta messaging tier, and a wrong guess
# either throttles a legitimate campaign or gets messages rejected. Set it from the
# WhatsApp Business account's actual limits once the production account exists.
# Empty means no client-side pacing.
DISPATCH_RATE_PER_SECOND=
DISPATCH_MAX_CONCURRENT=10

# ---------------------------------------------------------------- templates [D24]
# Purpose -> approved template name. Names only; the content is written and approved
# by the client through Meta and arrives via the [D6] synchronization.
TEMPLATE_BOOKING_CONFIRMATION=
TEMPLATE_WINDOW_FALLBACK=

# ---------------------------------------------------------------- opt-out [D5]
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,OPT OUT,OPTOUT

# ---------------------------------------------------------------- slot policy [D8]
DEMO_DURATION_MINUTES=30
DEMO_BUFFER_MINUTES=15
DEMO_WORKING_DAYS=MON,TUE,WED,THU,FRI
DEMO_WORKING_HOURS_START=10:00
DEMO_WORKING_HOURS_END=18:00
DEMO_BOOKING_HORIZON_DAYS=14
DEMO_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- qualification [D9][D37]
# Which extracted fields must be present before a lead can qualify. EMPTY BY DESIGN:
# [D37] has not decided the criteria, and with no fields configured nothing ever reaches
# QUALIFIED. The machinery is complete and inert until the client supplies these, which
# is a configuration change rather than a code change.
QUALIFICATION_REQUIRED_FIELDS=

# ---------------------------------------------------------------- customer copy [D21]
# Configurable content, never hard-coded. Wording is not final.
# ---------------------------------------------------------------- conversations (§9, §10)
# How many prior turns are sent to the model. A context window is finite and the recent
# turns are what the next reply depends on; tune alongside the model choice in Phase 10.
CONVERSATION_HISTORY_TURNS=20
# The AI's operating instructions. Configuration because it is customer-facing
# behaviour and Phase 10 will iterate on it against real conversations.
AI_SYSTEM_PROMPT=You are a helpful assistant replying to a customer on WhatsApp on behalf of the business. Be brief and professional. Only state facts that appear in the conversation or in verified information provided to you. If you do not know something, say you will have a colleague follow up. Never invent prices, availability, or commitments.

MSG_RAG_FALLBACK=I don't have verified information on that yet. Let me have someone from our team follow up with you.
MSG_BOOKING_CONFIRMATION=Your demo is confirmed for {start_time} ({timezone}).
MSG_OPT_OUT_RESPONSE=You have been unsubscribed and will not receive further messages.

# ---------------------------------------------------------------- frontend [D13]
# Set in the frontend environment (frontend/.env.local or Vercel), not the backend.
# The BFF proxy uses it server-side; it must never be exposed to the browser, which is
# why it carries no NEXT_PUBLIC_ prefix.
INTERNAL_API_BASE_URL=http://localhost:8000
