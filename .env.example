# Environment configuration template (specification §24).
#
# Copy to backend/.env for local development. Never commit a real .env (CLAUDE.md).
# Production values come from Secret Manager, not from files.
#
# Defaults here select FAKE providers, so the stack runs locally with no credentials.

# ---------------------------------------------------------------- core
APP_ENV=local
APP_SECRET=dev-insecure-change-me
LOG_LEVEL=INFO
LOG_FORMAT=console

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_marketing

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ---------------------------------------------------------------- session [D2]
SESSION_COOKIE_NAME=wam_session
# Keep true in production. May be false only for local http development.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------------- provider selection
# fake | meta
WHATSAPP_PROVIDER=fake
# fake | openrouter
LLM_PROVIDER=fake
# fake | local_sentence_transformer
EMBEDDING_PROVIDER=fake
# fake | google
CALENDAR_PROVIDER=fake
# fake | hubspot
CRM_PROVIDER=fake
# inline | cloud_tasks
QUEUE_PROVIDER=inline

# ---------------------------------------------------------------- WhatsApp
# fake | meta. Everything below is required only when WHATSAPP_PROVIDER=meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Chosen by you and echoed back to Meta during the webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=
# Meta's App Secret. Used to verify the HMAC-SHA256 signature on every webhook
# delivery (§19). Not listed in §24; without it anyone who knows the URL could
# fabricate customer replies and opt-outs.
WHATSAPP_APP_SECRET=
# WhatsApp Business Account ID. Message templates hang off the WABA, not the phone
# number, so the template sync needs it ([D6]).
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_TIMEOUT_SECONDS=15

# Meta permits free-form (non-template) replies only within this many hours of the
# customer's last inbound message. Configurable because Meta has changed it before.
CUSTOMER_SERVICE_WINDOW_HOURS=24

# ---------------------------------------------------------------- LLM (Phase 10)
OPENROUTER_API_KEY=
# [D17] No default. Chosen after Phase 10 benchmarking; required when
# LLM_PROVIDER=openrouter.
OPENROUTER_MODEL=

# ---------------------------------------------------------------- embeddings [D1]
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the pgvector column width. 384 for all-MiniLM-L6-v2. Changing this is a
# migration plus full re-embedding.
EMBEDDING_DIMENSION=384

# ---------------------------------------------------------------- Google Cloud (Phase 7)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_TASKS_QUEUE=
WORKER_BASE_URL=
WORKER_SERVICE_ACCOUNT_EMAIL=

# ---------------------------------------------------------------- Calendar (Phase 11)
# [D7] One shared sales calendar, Google OAuth.
GOOGLE_CALENDAR_ID=
# [D19] The OAuth refresh token lives in Secret Manager, never here and never in the
# database. These name its location.
GOOGLE_SECRET_MANAGER_PROJECT=
GOOGLE_CALENDAR_TOKEN_SECRET_NAME=

# ---------------------------------------------------------------- CRM (Phase 12)
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------- audience [D4][D20]
AUDIENCE_PHONE_DEFAULT_REGION=IN

# Maps the client's spreadsheet headers onto platform fields. A phone column is
# mandatory and must be required, since the normalized number is the WhatsApp
# identity ([D11]).
#
# The value below is a DEVELOPMENT PLACEHOLDER, not the client's format. Production
# refuses to start until it is replaced, so building the pipeline ahead of the
# client's file cannot leak invented column names into production ([D20]).
# Swapping in the real names needs no code change.
AUDIENCE_COLUMN_SCHEMA=[{"source": "Phone", "field": "phone", "required": true}, {"source": "Name", "field": "full_name", "required": false}, {"source": "Email", "field": "email", "required": false}]

# Upload limits (§19).
AUDIENCE_MAX_FILE_BYTES=5242880
AUDIENCE_MAX_ROWS=50000

# ---------------------------------------------------------------- opt-out [D5]
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,OPT OUT,OPTOUT

# ---------------------------------------------------------------- slot policy [D8]
DEMO_DURATION_MINUTES=30
DEMO_BUFFER_MINUTES=15
DEMO_WORKING_DAYS=MON,TUE,WED,THU,FRI
DEMO_WORKING_HOURS_START=10:00
DEMO_WORKING_HOURS_END=18:00
DEMO_BOOKING_HORIZON_DAYS=14
DEMO_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- qualification [D9]
# Comma-separated required fields. Empty until the criteria are confirmed.
QUALIFICATION_REQUIRED_FIELDS=

# ---------------------------------------------------------------- customer copy [D21]
# Configurable content, never hard-coded. Wording is not final.
MSG_RAG_FALLBACK=I don't have verified information on that yet. Let me have someone from our team follow up with you.
MSG_BOOKING_CONFIRMATION=Your demo is confirmed for {start_time} ({timezone}).
MSG_OPT_OUT_RESPONSE=You have been unsubscribed and will not receive further messages.

# ---------------------------------------------------------------- frontend [D13]
# Set in the frontend environment (frontend/.env.local or Vercel), not the backend.
# The BFF proxy uses it server-side; it must never be exposed to the browser, which is
# why it carries no NEXT_PUBLIC_ prefix.
INTERNAL_API_BASE_URL=http://localhost:8000
