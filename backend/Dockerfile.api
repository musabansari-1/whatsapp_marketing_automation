# API service image (Cloud Run).
#
# The frontend is NOT containerized: it deploys to Vercel ([D12]). Only the API and
# worker get images.
#
# This image deliberately excludes the embedding model. Embeddings run in the worker
# ([D1]), so the API stays slim and cold-starts fast.

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# uv resolves and installs from the committed lockfile for reproducible builds.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Dependency layer first so application edits do not invalidate it.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

ENV PATH="/app/.venv/bin:$PATH"

# Run as a non-root user (§19).
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

# Cloud Run supplies PORT; default for local runs.
ENV PORT=8080
EXPOSE 8080

# Single worker per container: Cloud Run scales by adding instances, and the
# process must stay stateless.
CMD ["sh", "-c", "exec uvicorn app.api.main:app --host 0.0.0.0 --port ${PORT}"]
