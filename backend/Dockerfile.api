# API service image (Cloud Run).
#
# The frontend is NOT containerized: it deploys to Vercel ([D12]). Only the API and
# worker get images.
#
# This image deliberately excludes the embedding model. Embeddings run in the worker
# ([D1]), so the API stays slim and cold-starts fast.

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Run as a non-root user (§19). Created before anything is copied so every file is
# written with the right owner; a `chown -R` afterwards copied the whole virtualenv
# into a fresh layer on every code change.
RUN useradd --create-home --uid 10001 appuser     && mkdir -p /app     && chown appuser:appuser /app

WORKDIR /app
USER appuser

# uv resolves and installs from the committed lockfile for reproducible builds.
# Pinned: `latest` changes whenever uv releases, which invalidates every cached
# layer below it and turns each deploy into a full rebuild.
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv

# Dependency layer first so application edits do not invalidate it.
COPY --chown=appuser:appuser pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY --chown=appuser:appuser alembic.ini ./
COPY --chown=appuser:appuser alembic ./alembic
COPY --chown=appuser:appuser app ./app
# The product catalog, applied by `python -m app.cli configure-products` from the migrate
# job's image (Phase 27). Business configuration, never secrets.
COPY --chown=appuser:appuser config ./config

ENV PATH="/app/.venv/bin:$PATH"

# Cloud Run supplies PORT; default for local runs.
ENV PORT=8080
EXPOSE 8080

# Single worker per container: Cloud Run scales by adding instances, and the
# process must stay stateless.
CMD ["sh", "-c", "exec uvicorn app.api.main:app --host 0.0.0.0 --port ${PORT}"]
